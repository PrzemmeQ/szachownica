{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "przy-szachownicy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomV2" }]
  },
  // v2: nowa klasa i usunięcie starej = wyczyszczenie wszystkich danych testowych (wspólny ranking od zera).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomV2"], "deleted_classes": ["Room"] }
  ],
  "vars": {
    // Strony, które mogą łączyć się z serwerem (CORS i WebSocket).
    "ALLOWED_ORIGINS": "https://przemmeq.github.io",
    // Pokoje przechowywane tylko w UE. Pusty = bez ograniczenia (lokalnie w .dev.vars).
    "JURISDICTION": "eu",
    // "1" = dozwolone bardzo krótkie tempa i skrócone limity (tylko testy).
    "TEST_MODE": "0",
    // Adres aplikacji w linkach do zmiany hasła.
    "APP_URL": "https://przemmeq.github.io/szachownica/przy-szachownicy/"
    // Odzyskiwanie hasła e-mailem (Resend): `npx wrangler secret put RESEND_API_KEY` i `MAIL_FROM`
    // (np. "Przy Szachownicy <haslo@twojadomena.pl>"). Bez nich odzyskiwanie jest wyłączone.
  },
  // Bez logów zapytań (RODO: nie przechowujemy adresów IP).
  "observability": { "enabled": false }
}
